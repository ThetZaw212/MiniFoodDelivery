{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/orders" } ]
      },
      "delivery": {
        "ClusterId": "delivery",
        "Match": { "Path": "/delivery/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/delivery" } ]
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/notifications" } ]
      },
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/auth" } ]
      }
    },
    "Clusters": {
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "catalog-1": { "Address": "http://localhost:5081" }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering": { "Address": "http://localhost:5083" }
        }
      },
      "delivery": {
        "Destinations": {
          "delivery": { "Address": "http://localhost:5084" }
        }
      },
      "notification": {
        "Destinations": {
          "notification": { "Address": "http://localhost:5085" }
        }
      },
      "auth": {
        "Destinations": {
          "auth": { "Address": "http://localhost:5086" }
        }
      }
    }
  }
}
