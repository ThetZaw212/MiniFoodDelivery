# Copy this file to .env
# Use the SA password of the sqlserver2022 container you already run.
SQL_SA_PASSWORD=ChangeMe_ToYourSaPassword1
SQL_HOST=localhost
SQL_PORT=1433
SQL_USER=sa

REDIS_HOST=localhost
REDIS_PORT=6379

# Used by Ordering when you run with `dotnet run`.
GRPC_CATALOG=http://localhost:5081
GRPC_DELIVERY=http://localhost:5084

# Activate the imported n8n workflow first. Test-mode URL is /webhook-test/.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/minifood-order-created
